{
    "name": "j87nl/laravel-cms",
    "description": "Block-based CMS core for Laravel: pages, blocks and server-side public rendering.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "cms",
        "blocks",
        "seo",
        "sitemap"
    ],
    "homepage": "https://github.com/J87NL/laravel-cms",
    "authors": [
        {
            "name": "Johan Montenij",
            "homepage": "https://j87.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/J87NL/laravel-cms/issues",
        "source": "https://github.com/J87NL/laravel-cms"
    },
    "require": {
        "php": "^8.5",
        "illuminate/cache": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/mcp": "^0.7",
        "spatie/laravel-medialibrary": "^11.23",
        "symfony/html-sanitizer": "^7.4.13|^8.0.13",
        "tranquil-tools/laravel-form-builder": "^1.7"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "J87NL\\Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "J87NL\\Cms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "J87NL\\Cms\\CmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
